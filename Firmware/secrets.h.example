// ============================================================
//  DingDong device secrets  ── template
// ============================================================
//  Copy this file to "secrets.h" in the same folder, then edit
//  the values below to match your environment. The real
//  "secrets.h" is listed in the repository .gitignore so your
//  credentials never reach a commit.
//
//  Every macro here is optional: if you leave one out, the
//  default from config.h is used. Define only the ones you want
//  to override.
//
//  Anyone re-publishing or forking the project should keep their
//  own credentials in their own untracked secrets.h.
// ============================================================
#pragma once

// ---- Wi-Fi network the device should join -----------------------------
#define DINGDONG_WIFI_SSID      "ExampleSSID"
#define DINGDONG_WIFI_PASSWORD  "ExamplePassword123"

// ---- ControlPlan PC endpoint ------------------------------------------
// IP / hostname and port of the PC running the ControlPlan app.
// The device fetches its enabled-utility list from /config and
// the per-utility counts from /mentions on this server.
//
// 192.0.2.x is RFC 5737 documentation range -- replace with your
// PC's actual LAN address (shown in the ControlPlan app title bar).
#define DINGDONG_CONFIG_URL     "http://192.0.2.50:8088/config"
#define DINGDONG_MENTIONS_URL   "http://192.0.2.50:8088/mentions"

// ---- Shared-secret auth token -----------------------------------------
// Copy the value from ControlPlan -> Security tab -> Auth token. The
// firmware sends it in the X-DingDong-Token header; requests without
// a matching token are rejected with HTTP 401.
#define DINGDONG_AUTH_TOKEN     "paste-token-from-controlplan-here"

// ---- Optional tunables ------------------------------------------------
// Uncomment to override the default poll interval (seconds).
// #define DINGDONG_DEFAULT_POLL_SEC  5
